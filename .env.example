# Indicador 2001 — contrato de configuração.
# Copie para `.env` e preencha. `.env` é gitignored: nenhum segredo entra no repositório.
#   cp .env.example .env

# ─── Postgres (subido pelo compose) ───────────────────────────────────────────
POSTGRES_USER=indicador
POSTGRES_PASSWORD=indicador
POSTGRES_DB=indicador_2001
POSTGRES_PORT=5432
DATABASE_URL=postgresql://indicador:indicador@localhost:5432/indicador_2001?schema=public

# ─── Qdrant (subido pelo compose) ─────────────────────────────────────────────
QDRANT_HTTP_PORT=6333
QDRANT_URL=http://localhost:6333
# Deixe vazio no dev local; obrigatório em qualquer Qdrant remoto.
QDRANT_API_KEY=
QDRANT_COLLECTION=filmes

# ─── Anthropic (o Indicador) ──────────────────────────────────────────────────
# Sem esta chave o chat não funciona; o resto do projeto (ingestão, embeddings
# locais, exportação) roda normalmente.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ─── Embeddings ───────────────────────────────────────────────────────────────
# voyage  → provider recomendado pela Anthropic (padrão)
# openai  → alternativa
# local   → fallback determinístico, sem rede. Só para dev/demo: a qualidade da
#           busca semântica é muito inferior. Nunca usar para indexar o acervo real.
EMBEDDINGS_PROVIDER=local

VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

OPENAI_API_KEY=
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# ─── TMDB (camada factual — consulta, nunca material de treino) ───────────────
# Token de leitura v4 da API do TMDB. Sem ele, `pnpm ingerir:tmdb` cai no
# fixture local `data/filmes-fixture.json`.
TMDB_ACCESS_TOKEN=
TMDB_LANGUAGE=pt-BR

# ─── Aplicação ────────────────────────────────────────────────────────────────
# Login simples que distingue Sonia de Mirella. Senha compartilhada pelas duas;
# deixe vazio para dispensar a senha no dev local.
APP_SENHA_CURADORIA=
APP_SESSION_SECRET=troque-este-valor-por-uma-string-aleatoria-longa
