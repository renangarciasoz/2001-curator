# 2001 Curator — configuration contract.
# Copy to `.env` and fill in. `.env` is gitignored: no secret enters the repository.
#   cp .env.example .env

# ─── Postgres (started by compose) ────────────────────────────────────────────
# `curator_2001`, not `2001-curator`: a Postgres identifier cannot start with a
# digit or carry a hyphen without being quoted at every reference.
POSTGRES_USER=curator
POSTGRES_PASSWORD=curator
POSTGRES_DB=curator_2001
POSTGRES_PORT=5432
DATABASE_URL=postgresql://curator:curator@localhost:5432/curator_2001?schema=public
# Direct (unpooled) connection, used by migrations only. Locally there is no
# pooler so it is the same URL; on Neon or Supabase these differ, and pointing
# migrations at the pooler fails on the session-level statements they issue.
DIRECT_DATABASE_URL=postgresql://curator:curator@localhost:5432/curator_2001?schema=public
#
# On Neon the two differ by one token in the hostname — the pooled one carries
# `-pooler`. Both keep the `sslmode=require` Neon hands you:
#
#   DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
#   DIRECT_DATABASE_URL=postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require
#
# Neon's pooler is PgBouncer in transaction mode, which does not keep prepared
# statements across queries. If the app starts failing on them, append
# `&pgbouncer=true` to DATABASE_URL only — never to the direct one.
#
# Throwaway database used only by `pnpm db:migrate:verify` to prove the versioned
# migrations produce exactly the schema.prisma. Create it once:
#   docker compose -f compose.yaml -f compose.dev.yaml exec -T postgres \
#     psql -U curator -d postgres -c 'CREATE DATABASE curator_2001_shadow'
SHADOW_DATABASE_URL=postgresql://curator:curator@localhost:5432/curator_2001_shadow?schema=public

# ─── Qdrant (started by compose) ──────────────────────────────────────────────
QDRANT_HTTP_PORT=6333
QDRANT_URL=http://localhost:6333
# Leave empty for local dev; required for any remote Qdrant.
QDRANT_API_KEY=
QDRANT_COLLECTION=films

# ─── Anthropic (the Indicador) ────────────────────────────────────────────────
# Without this key the chat does not work; everything else (ingestion, local
# embeddings, export) runs normally.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ─── Embeddings ───────────────────────────────────────────────────────────────
# voyage  → the provider Anthropic recommends (default)
# openai  → alternative
# local   → deterministic offline fallback. Dev and demo only: semantic search
#           quality is far worse. Never use it to index the real archive.
EMBEDDINGS_PROVIDER=local

VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

OPENAI_API_KEY=
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# ─── TMDB (factual layer — lookup only, never training material) ──────────────
# TMDB v4 read access token. Without it, `pnpm ingest:tmdb` falls back to the
# local fixture at `data/films-fixture.json`.
TMDB_ACCESS_TOKEN=
TMDB_LANGUAGE=pt-BR

# ─── Application ──────────────────────────────────────────────────────────────
# Simple login that tells Sonia from Mirella. Optional in development;
# MANDATORY in production, where an empty value would let anyone who finds the
# URL sign in as a curator and write to the dataset.
APP_CURATION_PASSWORD=
# Signs the cookie that decides who a review is attributed to. Use a different
# long random value per environment.
APP_SESSION_SECRET=replace-this-with-a-long-random-string
