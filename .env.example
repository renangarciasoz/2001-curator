# Indicador 2001 — configuration contract.
# Copy to `.env` and fill in. `.env` is gitignored: no secret enters the repository.
#   cp .env.example .env

# ─── Postgres (started by compose) ────────────────────────────────────────────
POSTGRES_USER=indicador
POSTGRES_PASSWORD=indicador
POSTGRES_DB=indicador_2001
POSTGRES_PORT=5432
DATABASE_URL=postgresql://indicador:indicador@localhost:5432/indicador_2001?schema=public
# Direct (unpooled) connection, used by migrations only. Locally there is no
# pooler so it is the same URL; on Neon or Supabase these differ, and pointing
# migrations at the pooler fails on the session-level statements they issue.
DIRECT_DATABASE_URL=postgresql://indicador:indicador@localhost:5432/indicador_2001?schema=public
# Throwaway database used only by `pnpm db:migrate:verify` to prove the versioned
# migrations produce exactly the schema.prisma. Create it once:
#   docker compose -f compose.yaml -f compose.dev.yaml exec -T postgres \
#     psql -U indicador -c 'CREATE DATABASE indicador_2001_shadow'
SHADOW_DATABASE_URL=postgresql://indicador:indicador@localhost:5432/indicador_2001_shadow?schema=public

# ─── Qdrant (started by compose) ──────────────────────────────────────────────
QDRANT_HTTP_PORT=6333
QDRANT_URL=http://localhost:6333
# Leave empty for local dev; required for any remote Qdrant.
QDRANT_API_KEY=
QDRANT_COLLECTION=films

# ─── Anthropic (the Indicador) ────────────────────────────────────────────────
# Without this key the chat does not work; everything else (ingestion, local
# embeddings, export) runs normally.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ─── Embeddings ───────────────────────────────────────────────────────────────
# voyage  → the provider Anthropic recommends (default)
# openai  → alternative
# local   → deterministic offline fallback. Dev and demo only: semantic search
#           quality is far worse. Never use it to index the real archive.
EMBEDDINGS_PROVIDER=local

VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

OPENAI_API_KEY=
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# ─── TMDB (factual layer — lookup only, never training material) ──────────────
# TMDB v4 read access token. Without it, `pnpm ingest:tmdb` falls back to the
# local fixture at `data/films-fixture.json`.
TMDB_ACCESS_TOKEN=
TMDB_LANGUAGE=pt-BR

# ─── Application ──────────────────────────────────────────────────────────────
# Simple login that tells Sonia from Mirella. Shared password; leave empty to
# skip the password prompt in local dev.
APP_CURATION_PASSWORD=
APP_SESSION_SECRET=replace-this-with-a-long-random-string
