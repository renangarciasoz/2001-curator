{
  "name": "@epcvip/indicador-2001",
  "version": "0.1.0",
  "private": true,
  "description": "Indicador 2001 — ferramenta interna de curadoria de recomendacao de filmes da 2001 Video",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "next build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:verify": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code",
    "db:seed": "node --env-file-if-exists=.env --conditions react-server --import tsx scripts/seed-demo.ts",
    "db:studio": "prisma studio",
    "dev": "next dev",
    "exportar:dataset": "node --env-file-if-exists=.env --conditions react-server --import tsx scripts/export-dataset.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "indexar:embeddings": "node --env-file-if-exists=.env --conditions react-server --import tsx scripts/index-embeddings.ts",
    "ingerir:tmdb": "node --env-file-if-exists=.env --conditions react-server --import tsx scripts/ingest-tmdb.ts",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.127.0",
    "@prisma/client": "6.19.3",
    "@qdrant/js-client-rest": "1.19.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "prettier": "3.9.8",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@10.33.4+sha224.86826a3e9e8a9b092b0ec632420135599819f8672302907955fc1f6d",
  "engines": {
    "node": ">=24"
  }
}
