// 2001 Curator — data model.
//
// Two structural rules run through this schema and must not be broken:
//
//  1. THE TWO BUCKETS. Every field carries its provenance. The factual layer
//     comes from a third party (TMDB) and is lookup ONLY — never training
//     material. The curatorial layer is the 2001 archive's own content and is
//     what feeds Phase 2. In `film` the two live on the same row, split into
//     blocks and tracked by `factual_source` / `curatorial_source`. The dataset
//     exporter reads the curatorial block only, and only when the source is
//     CURATION_2001.
//
//  2. THE WHY IS ALWAYS CAPTURED. `connection.why` is NOT NULL and non-empty.
//     `conversation.correction_reason` is required whenever there is a
//     `correction`. Both are enforced by CHECK constraints in the migration,
//     not only by the application.
//
// Attribute order follows the eight data-model categories:
// PK → FKs → secondary identifiers → domain → derived → statuses → flags → timestamps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // The app's connection. On a serverless host this must be the *pooled* URL:
  // every cold start opens a connection, and Postgres runs out long before
  // traffic does.
  url = env("DATABASE_URL")

  // Migrations and introspection. These need a direct connection — a pooler
  // cannot run the session-level statements they issue. Locally there is no
  // pooler, so both point at the same database.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Vocabularies
// ─────────────────────────────────────────────────────────────────────────────

/// Who signs a curatorial decision. DEMO is not a person: it marks seeded
/// demonstration data, which is never exported as training data.
enum Curator {
  SONIA
  MIRELLA
  BOTH
  DEMO
}

/// Descriptive, never a value judgement. Every film is a film.
enum CommercialRegister {
  COMMERCIAL
  ARTHOUSE
  BOTH
}

/// Archive taxonomy, mirroring the curators' folder structure.
enum ArchiveCategory {
  COMPANY_HISTORY
  TRAINING_METHOD
  CURATION
  CLIPPING
  INTERVIEWS
  MAGAZINES_2001
  COURSES
  OMO_LIST
  SERVICE_AND_REAL_CASES
  SONIA_TEXTS
  AWARDS
  MARKETING_AND_EVENTS
}

enum ConnectionType {
  ENTRY_POINT
  IF_YOU_LIKED
  BEFORE_WATCHING
  RELEASE_TO_ARCHIVE
  ARCHIVE_TO_RELEASE
  OTHER
}

enum EditorialListType {
  MONTHLY_TOP
  THEMATIC
  EVENT
  HISTORIC_OMO
}

enum Consensus {
  AGREEMENT
  DISAGREEMENT
  ONLY_ONE_REVIEWED
}

/// The `record_feedback` quality gate.
enum Quality {
  ABSORB
  DISCARD
  REVIEW
}

enum Confidence {
  HIGH
  NORMAL
}

/// Provenance of the factual layer. Third-party bucket: lookup, never training.
enum FactualSource {
  TMDB
  DEV_FIXTURE
}

/// Provenance of the curatorial layer. Only CURATION_2001 is trainable material.
enum CuratorialSource {
  CURATION_2001
  DEMO
}

enum ConversationRole {
  RECOMMENDED_BY_AI
  CORRECTED_BY_CURATOR
}

enum MessageAuthor {
  CURATOR
  INDICADOR
}

// ─────────────────────────────────────────────────────────────────────────────
// Archive
// ─────────────────────────────────────────────────────────────────────────────

model Film {
  id String @id @default(uuid()) @db.Uuid

  tmdbId Int? @unique @map("tmdb_id")

  // ── factual layer (third-party bucket — lookup, never training) ──
  title           String
  originalTitle   String? @map("original_title")
  year            Int?
  director        String?
  country         String?
  factualSynopsis String? @map("factual_synopsis")
  posterPath      String? @map("poster_path")

  // ── 2001 curatorial layer (own bucket — this is the differentiator) ──
  /// 'conforta' | 'desafia' | 'destrói' | … — deliberately open vocabulary,
  /// because the words belong to the curators and not to the schema.
  emotionalTone      String?             @map("emotional_tone")
  /// What the film does to the viewer.
  whatItProvokes     String?             @map("what_it_provokes")
  commercialRegister CommercialRegister? @map("commercial_register")
  /// The months-long study. Free text.
  curatorialNotes    String?             @map("curatorial_notes")
  /// Why it matters in the history of cinema.
  historicalContext  String?             @map("historical_context")
  archiveCategory    ArchiveCategory?    @map("archive_category")
  reviewedBy         Curator[]           @map("reviewed_by")

  factualSource    FactualSource     @map("factual_source")
  curatorialSource CuratorialSource? @map("curatorial_source")

  /// Set by the indexer when the Qdrant vector reflects the current text.
  indexedAt DateTime? @map("indexed_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  outgoingConnections Connection[]        @relation("connection_source")
  incomingConnections Connection[]        @relation("connection_target")
  journeys            JourneyFilm[]
  editorialLists      EditorialListFilm[]
  conversations       ConversationFilm[]
  watchedBy           ProfileWatchedFilm[]

  @@index([archiveCategory])
  @@index([indexedAt])
  @@map("film")
}

/// The heart of the Method: the bridge between two films, and its reason.
model Connection {
  id String @id @default(uuid()) @db.Uuid

  sourceFilmId String @map("source_film_id") @db.Uuid
  targetFilmId String @map("target_film_id") @db.Uuid

  type ConnectionType
  /// 'gênero' | 'elenco' | 'direção' | 'tema' | … — open vocabulary.
  bridgedBy String @map("bridged_by")
  /// REQUIRED. Without the why the bridge is noise. A CHECK keeps it non-empty.
  why     String
  curator Curator

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sourceFilm Film @relation("connection_source", fields: [sourceFilmId], references: [id], onDelete: Cascade)
  targetFilm Film @relation("connection_target", fields: [targetFilmId], references: [id], onDelete: Cascade)

  @@unique([sourceFilmId, targetFilmId, type])
  @@index([sourceFilmId])
  @@map("connection")
}

/// A timeless formative track: 'Começando Kurosawa'.
model Journey {
  id String @id @default(uuid()) @db.Uuid

  title String
  /// Which viewer this journey forms.
  objective String
  curator   Curator

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  films    JourneyFilm[]
  profiles ProfileJourney[]

  @@map("journey")
}

model JourneyFilm {
  journeyId String @map("journey_id") @db.Uuid
  filmId    String @map("film_id") @db.Uuid

  position Int
  /// Why this film, in this position.
  whyNote String @map("why_note")

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  film    Film    @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@id([journeyId, filmId])
  @@unique([journeyId, position])
  @@map("journey_film")
}

/// A recurring, dated list — heir to the Lista OMO.
model EditorialList {
  id String @id @default(uuid()) @db.Uuid

  title String
  /// Month or season: '2026-03', 'Mostra de SP 2026'.
  period  String
  type    EditorialListType
  curator Curator

  publishedAt DateTime @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  films EditorialListFilm[]

  @@index([period])
  @@map("editorial_list")
}

model EditorialListFilm {
  listId String @map("list_id") @db.Uuid
  filmId String @map("film_id") @db.Uuid

  position Int
  /// One line of curation about the film within this list.
  curationLine String @map("curation_line")

  list EditorialList @relation(fields: [listId], references: [id], onDelete: Cascade)
  film Film          @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@id([listId, filmId])
  @@unique([listId, position])
  @@map("editorial_list_film")
}

// ─────────────────────────────────────────────────────────────────────────────
// Conversation and the feedback loop — the most important data in the project
// ─────────────────────────────────────────────────────────────────────────────

/// One chat session between a curator and the Indicador. Holds the transcript;
/// the exportable unit of the dataset is `Conversation`, not this.
model Session {
  id String @id @default(uuid()) @db.Uuid

  profileId String? @map("profile_id") @db.Uuid

  /// Who is driving the session (never BOTH: one person per session).
  curator Curator
  title   String?

  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile       Profile?       @relation(fields: [profileId], references: [id], onDelete: SetNull)
  messages      Message[]
  conversations Conversation[]

  @@index([curator])
  @@map("session")
}

model Message {
  id String @id @default(uuid()) @db.Uuid

  sessionId String @map("session_id") @db.Uuid

  author MessageAuthor
  /// Raw Messages API content blocks (text / tool_use / tool_result / thinking),
  /// stored verbatim so the conversation loop can be replayed faithfully.
  blocks   Json
  position Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, position])
  @@map("message")
}

/// The unit of the curatorial dataset: a request, what the AI asked, what it
/// recommended, and the curator's correction with its reason.
model Conversation {
  id String @id @default(uuid()) @db.Uuid

  sessionId String? @map("session_id") @db.Uuid
  profileId String? @map("profile_id") @db.Uuid

  /// Which Method the Indicador was following when this happened. Written at
  /// record time, never at export time: the prompt changes, and a row must keep
  /// saying which version produced it.
  methodVersion Int @map("method_version")

  /// What the person wanted.
  userRequest String @map("user_request")
  /// What the AI asked before recommending. JSON array of strings.
  aiQuestions Json   @map("ai_questions")
  /// What it suggested, with its reasoning.
  aiRecommendation String @map("ai_recommendation")

  /// The curator's adjustment. Null when both agreed with no change, and null
  /// on disagreement — disagreement elects no winner; both readings go to
  /// `disagreement_note`.
  correction       String?
  /// REQUIRED when there is a correction. A CHECK enforces the rule in the database.
  correctionReason String? @map("correction_reason")

  reviewedBy Curator? @map("reviewed_by")
  /// Both readings recorded, with attribution, when the curators disagreed.
  disagreementNote String? @map("disagreement_note")

  consensus  Consensus?
  quality    Quality?
  confidence Confidence?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  session Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  profile Profile?           @relation(fields: [profileId], references: [id], onDelete: SetNull)
  films   ConversationFilm[]

  @@index([quality])
  @@index([consensus])
  @@map("conversation")
}

/// Which films the AI recommended and which ones the curator put in their place.
/// Makes the Phase 2 dataset usable without re-parsing free text.
model ConversationFilm {
  conversationId String @map("conversation_id") @db.Uuid
  filmId         String @map("film_id") @db.Uuid

  role     ConversationRole
  position Int

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  film         Film         @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@id([conversationId, filmId, role])
  @@map("conversation_film")
}

// ─────────────────────────────────────────────────────────────────────────────
// Memory between visits
// ─────────────────────────────────────────────────────────────────────────────

model Profile {
  id String @id @default(uuid()) @db.Uuid

  /// Viewer identifier. In Phase 1 this is the persona a curator is testing.
  userId String @unique @map("user_id")

  likes      String[]
  avoids     String[]
  repertoire String?
  /// Current context, when the person shares it.
  lifeMoment String? @map("life_moment")
  /// Treatment: 'padrao' | 'premium' | …
  tier String @default("padrao")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  watchedFilms  ProfileWatchedFilm[]
  journeyHistory ProfileJourney[]
  sessions      Session[]
  conversations Conversation[]

  @@map("profile")
}

/// "Have I already rented this one?"
model ProfileWatchedFilm {
  profileId String @map("profile_id") @db.Uuid
  filmId    String @map("film_id") @db.Uuid

  note String?

  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  film    Film    @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@id([profileId, filmId])
  @@map("profile_watched_film")
}

/// Where the person has already been led.
model ProfileJourney {
  profileId String @map("profile_id") @db.Uuid
  journeyId String @map("journey_id") @db.Uuid

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@id([profileId, journeyId])
  @@map("profile_journey")
}
